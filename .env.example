# cp .env.example .env 후 값 채우기 (.env는 커밋 금지)

# --- 인증 -------------------------------------------------------------------
# 토큰은 MERIDIAN_PROFILES 한 곳에만 둔다. CLAUDE_CODE_OAUTH_TOKEN 은 쓰지 않는다.
# (두 군데에 토큰이 있으면 어느 쪽이 실제로 쓰이는지 헷갈린다.)
#
# 인증은 아래의 setup-token 으로만 처리한다. 컨테이너 안에서 claude login 을
# 실행하는 방식은 사용하지 않는다.
# macOS의 claude CLI는 OAuth 토큰을 파일이 아니라 Keychain에 저장한다.
# 그래서 ~/.claude를 마운트해도 컨테이너는 빈 자격증명 저장소를 보고 401을 낸다.
# 호스트에서 계정마다 아래 명령으로 장기 토큰을 발급해 배열에 채운다:
#   claude setup-token
#
# 계정이 하나여도 원소 하나짜리 배열로 쓴다. 반드시 한 줄 JSON.
MERIDIAN_PROFILES=[{"id":"personal","oauthToken":"sk-ant-oat01-..."}]
MERIDIAN_DEFAULT_PROFILE=personal
# 라우팅: active | sticky | priority
MERIDIAN_ROUTING=active
# MERIDIAN_PROFILE_ORDER=work,personal   # routing=priority 일 때의 페일오버 순서

# 계정을 늘릴 때는 배열에 원소만 추가한다:
# MERIDIAN_PROFILES=[{"id":"personal","oauthToken":"sk-ant-oat01-..."},{"id":"work","oauthToken":"sk-ant-oat01-..."}]

# --- 서버 -------------------------------------------------------------------
# MERIDIAN_DEFAULT_AGENT=opencode  # 알 수 없는 클라이언트의 기본 어댑터

# --- 이미지/포트 -------------------------------------------------------------
# MERIDIAN_VERSION=1.68.0          # 특정 버전으로 고정하고 싶을 때 (기본값: latest)
# MERIDIAN_HOST_PORT=3466          # 기본값은 3456. npm 전역 설치본과 동시에 띄울 때만 변경
# MERIDIAN_BIND_ADDR=0.0.0.0       # 기본값은 127.0.0.1(루프백 전용). 다른 기기에서
#                                  # 접속해야 할 때만 변경하고, 이때 MERIDIAN_API_KEY 필수

# --- 선택 -------------------------------------------------------------------
# MERIDIAN_API_KEY=change-me       # 설정하면 모든 API/관리 라우트에 x-api-key 요구
# MERIDIAN_MAX_CONCURRENT=10
# MERIDIAN_1M_CONTEXT_SUPPORT=0    # 1M 컨텍스트 끄기 (Extra Usage 회피)
# MERIDIAN_DEBUG=1
