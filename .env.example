# .env.example 파일을 .env 로 복사한 뒤에 값을 채웁니다. .env 파일은 커밋하지 않습니다.

# --- 인증 -------------------------------------------------------------------

# 토큰은 MERIDIAN_PROFILES 한 곳에만 기재하며, CLAUDE_CODE_OAUTH_TOKEN 은 사용하지
# 않습니다. 두 곳에 토큰이 존재하면 어느 쪽이 실제로 사용되는지 판단하기 어렵기
# 때문입니다.
#
# 인증은 아래에 안내한 setup-token 명령으로만 처리합니다. 컨테이너 안에서 claude
# login 을 실행하는 방식은 사용하지 않습니다.
# macOS 의 claude CLI 는 OAuth 토큰을 파일이 아니라 Keychain 에 저장합니다. 따라서
# ~/.claude 디렉터리를 마운트하더라도 컨테이너는 비어 있는 자격증명 저장소를 읽게
# 되므로 401 오류를 반환합니다.
# 호스트에서 계정마다 아래 명령을 실행하여 장기 토큰을 발급한 뒤, 그 값을 배열에
# 기입합니다.
#   claude setup-token
#
# 계정이 하나뿐이더라도 원소가 하나인 배열로 작성합니다. 반드시 한 줄짜리 JSON
# 형식이어야 합니다.
MERIDIAN_PROFILES=[{"id":"personal","oauthToken":"sk-ant-oat01-..."}]

MERIDIAN_DEFAULT_PROFILE=personal

# 라우팅 방식: active | sticky | priority
MERIDIAN_ROUTING=active

# routing 이 priority 일 때 적용할 페일오버 순서입니다.
# MERIDIAN_PROFILE_ORDER=work,personal

# 계정을 추가할 때에는 배열에 원소를 하나 더 넣습니다.
# MERIDIAN_PROFILES=[{"id":"personal","oauthToken":"sk-ant-oat01-..."},{"id":"work","oauthToken":"sk-ant-oat01-..."}]

# --- 서버 -------------------------------------------------------------------

# 식별되지 않은 클라이언트에 적용할 기본 어댑터입니다.
# MERIDIAN_DEFAULT_AGENT=opencode

# --- 이미지/포트 -------------------------------------------------------------

# 특정 버전으로 고정할 때 지정합니다. 기본값은 latest 입니다.
# MERIDIAN_VERSION=1.68.0

# 기본값은 3456 입니다. npm 전역 설치본과 함께 실행할 때에만 변경합니다.
# MERIDIAN_HOST_PORT=3466

# 기본값은 127.0.0.1 이며 루프백 전용입니다. 다른 기기에서 접속해야 할 때에만
# 변경하고, 이 경우에는 MERIDIAN_API_KEY 를 반드시 함께 설정합니다.
# MERIDIAN_BIND_ADDR=0.0.0.0

# --- 선택 -------------------------------------------------------------------

# 설정하면 모든 API 라우트와 관리 라우트에서 x-api-key 를 요구합니다.
# MERIDIAN_API_KEY=change-me

# MERIDIAN_MAX_CONCURRENT=10

# 1M 컨텍스트를 비활성화합니다. Extra Usage 과금을 피할 때 사용합니다.
# MERIDIAN_1M_CONTEXT_SUPPORT=0

# 응답 끝에 붙는 "Files changed:" 요약을 끕니다. write 와 edit 호출, 그리고 bash 의
# 리다이렉션과 tee, sed -i 를 모아서 보여주는 기능입니다. 다음 요청에서 제거되기
# 때문에 컨텍스트에는 누적되지 않으며, 화면 표시만 없애는 설정입니다. 이전 이름은
# CLAUDE_PROXY_NO_FILE_CHANGES 이며 동작은 같습니다.
# MERIDIAN_NO_FILE_CHANGES=1

# MERIDIAN_DEBUG=1
